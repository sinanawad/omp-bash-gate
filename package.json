{
  "name": "omp-bash-gate",
  "version": "0.2.0",
  "description": "Model-assisted bash command safety gate for Oh My Pi (omp)",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "plugin",
    "security",
    "approval",
    "bash",
    "classifier"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinanawad/omp-bash-gate.git"
  },
  "bugs": {
    "url": "https://github.com/sinanawad/omp-bash-gate/issues"
  },
  "homepage": "https://github.com/sinanawad/omp-bash-gate#readme",
  "omp": {
    "name": "bash-gate",
    "description": "Three-tier bash safety gate: instant block/allow lists plus model classification through your own omp provider.",
    "extensions": [
      "./src/bash-gate.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=17.0.0",
    "@oh-my-pi/pi-coding-agent": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^17.1.1",
    "@oh-my-pi/pi-coding-agent": "^17.1.1",
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
